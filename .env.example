# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_APPS_SCRIPT_URL: Optional Google Apps Script Web App URL for syncing attendance to Google Spreadsheet
GOOGLE_APPS_SCRIPT_URL=

# ==============================================================================
# TURSO CLOUD SQLITE DATABASE (Disarankan untuk hosting serverless / Vercel)
# Daftar gratis di https://turso.tech
# ==============================================================================
# TURSO_DATABASE_URL: URL database Turso Anda (contoh: libsql://absensi-username.turso.io)
TURSO_DATABASE_URL=

# TURSO_AUTH_TOKEN: Token otentikasi dari database Turso Anda
TURSO_AUTH_TOKEN=
